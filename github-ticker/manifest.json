{
  "schemaVersion": 1,
  "id": "cxdog.github-ticker",
  "name": "GitHub Ticker",
  "version": "1.0.0",
  "author": "cxdog",
  "description": "Sports-ticker style scroll of recent activity on your GitHub repos. Polls GitHub through the gh CLI every few minutes.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Ticker.qml"
  },
  "barWidget": {
    "displayName": "GitHub Ticker",
    "description": "Scrolling feed of recent GitHub activity on your repos.",
    "category": "Fun",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "width": 700,
      "refreshMinutes": 5,
      "speed": 30
    },
    "schema": [
      {
        "key": "width",
        "type": "integer",
        "label": "Ticker width (px)",
        "min": 150,
        "max": 2000,
        "step": 10,
        "defaultValue": 520
      },
      {
        "key": "refreshMinutes",
        "type": "integer",
        "label": "Refresh every (minutes)",
        "min": 2,
        "max": 120,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "speed",
        "type": "integer",
        "label": "Scroll speed (px/s)",
        "min": 10,
        "max": 120,
        "step": 5,
        "defaultValue": 30
      }
    ]
  }
}
